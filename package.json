{
  "name": "ai-obs-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter \"./packages/**\" build && pnpm --parallel --filter @ai-obs/protocol --filter @ai-obs/db --filter @ai-obs/web --filter @ai-obs/worker dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @ai-obs/db db:generate",
    "db:migrate": "pnpm --filter @ai-obs/db db:migrate",
    "db:seed": "pnpm --filter @ai-obs/db db:seed",
    "dev:token": "tsx --env-file-if-exists=.env scripts/dev-token.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
