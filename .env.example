# Copy to .env. Never commit real secrets; never bake them into images.

# --- App
APP_URL=http://localhost:3000
# Long random string: `openssl rand -base64 48`
# In production the placeholder is refused: auth routes redirect to /login?error=config.
SESSION_SECRET=change-me-to-a-long-random-string
# Comma-separated e-mails (case-insensitive) that become admin of this deployment when they first log in
# (ADR-0028). Set at least one before the first login: an unknown e-mail that is neither listed here, nor invited,
# nor in ALLOWED_EMAIL_DOMAINS is refused. The list only grants admin at first login; changing the role later
# happens in Admin -> Members. `pnpm db:seed` makes the first address an admin member (default admin@example.com).
ADMIN_EMAILS=admin@example.com
# Comma-separated e-mail domains whose members join automatically as plain members at their first login
# (a provider-verified e-mail is required for OAuth). Empty = nobody joins without an invitation.
ALLOWED_EMAIL_DOMAINS=
# How many proxies in front of the web app append to X-Forwarded-For (default 1; the client IP is the n-th
# entry from the right). 0 = ignore X-Forwarded-For and use X-Real-IP only (safe only if the proxy sets it).
# Used by the login rate limits. Without a proxy these headers are client-controlled.
TRUSTED_PROXY_HOPS=1
# Collectors older than this are told to upgrade (GET /api/v1/collector-config). 0.5.0 is the first collector that
# speaks per-user tokens, `ai-obs login` and the .ai-obs.json dot file (ADR-0029, ADR-0030). Operators raise this
# only AFTER every collector is on 0.5.0 (release order: server first, then collectors, then this value).
# Leave it at 0.0.0 until then; set it to 0.5.0 after the rollout. It is advisory: ingest is never blocked by it.
MIN_COLLECTOR_VERSION=0.0.0

# --- Database
# Used by the docker `postgres` service (and to build the in-compose URLs)
POSTGRES_USER=ai_obs
POSTGRES_PASSWORD=ai_obs
POSTGRES_DB=ai_obs
POSTGRES_PORT=5432
# Runtime connection (local dev: postgres published on localhost). Services connect via dbFor(), which
# switches every connection to its role (app_web / app_ingest / app_worker) with SET ROLE,
# so RLS applies even with this single owner URL (ADR-0014).
DATABASE_URL=postgres://ai_obs:ai_obs@localhost:5432/ai_obs
# Production: one login per service (falls back to DATABASE_URL when empty), e.g.
#   DATABASE_URL_WEB=postgres://app_web:<DB_APP_WEB_PASSWORD>@db:5432/ai_obs
DATABASE_URL_WEB=
DATABASE_URL_INGEST=
DATABASE_URL_WORKER=
# Read by `migrate`: when set, the role becomes a LOGIN role with this password (re-applied each deploy).
DB_APP_WEB_PASSWORD=
DB_APP_INGEST_PASSWORD=
DB_APP_WORKER_PASSWORD=
# Schema owner used by `migrate` / `pnpm db:migrate` / `pnpm db:seed` (falls back to DATABASE_URL)
MIGRATE_DATABASE_URL=postgres://ai_obs:ai_obs@localhost:5432/ai_obs
# RLS integration tests (packages/db). Default: postgres://ai_obs:ai_obs@localhost:5432/ai_obs_test.
# The database name must end in _test: it is dropped and re-created on every run.
TEST_DATABASE_URL=

# --- E-mail (magic links, invitations, budget alerts). Dev: Mailpit on 1025, UI on http://localhost:8025
# Leave SMTP_HOST empty in dev: it means localhost for `pnpm dev` and the `mailpit` container inside Docker Compose.
SMTP_HOST=
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="ai-obs <no-reply@localhost>"
# Host ports of the dev Mailpit container (change them if MailHog or another tool already uses 1025/8025)
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- OAuth (ADR-0013). Callback URLs: ${APP_URL}/api/auth/google/callback, ${APP_URL}/api/auth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Docker compose
WEB_PORT=3000

# --- Worker (apps/worker)
# Rollup watermark and "retention ran today" marks. Mount a volume here in production; without it the worker
# falls back to a temp dir and re-folds every day after a restart (safe, just slower).
WORKER_STATE_DIR=
# Nightly retention runs once per UTC day, at or after this hour (0-23)
RETENTION_HOUR_UTC=3

# --- Ingest API (apps/web, POST /api/v1/ingest). Per-token token bucket, kept in memory PER INSTANCE.
INGEST_RATE_LIMIT_PER_MINUTE=60
INGEST_RATE_LIMIT_BURST=20
# Failed-authentication budget per client IP (invalid bearers only; valid tokens never spend it).
INGEST_FAILED_AUTH_PER_MINUTE=10
INGEST_FAILED_AUTH_BURST=20
# Proxies in front of the ingest routes that append to X-Forwarded-For (default 1, like TRUSTED_PROXY_HOPS).
INGEST_TRUSTED_PROXY_HOPS=1
# Ingest integration tests: own database, dropped and re-created per run (name must end in _test).
# Default: postgres://ai_obs:ai_obs@localhost:5432/ai_obs_ingest_test
INGEST_TEST_DATABASE_URL=
# Admin console integration tests (apps/web/test/admin): own database, dropped and re-created per run.
# Default: postgres://ai_obs:ai_obs@localhost:5432/ai_obs_admin_test
ADMIN_TEST_DATABASE_URL=
